# Mastra backend container for Railway (and any Docker host).
# Build context = lntera-aiag/ (set Railway "Root Directory" to lntera-aiag).
# See RAILWAY.md for the deploy runbook + required env vars.
# syntax=docker/dockerfile:1

# ── Build stage: Bun (fast installs). `bun install` replaces `npm ci`; `mastra build` then bundles the
# Hono server (esbuild/rollup) AND installs `.mastra/output`'s deps with Bun too — it picks the package
# manager from the lockfile present, and only bun.lock (generated by `bun install`) reaches the image
# (the npm/pnpm locks are dockerignored). The whole builder is discarded; only .mastra/output ships. ──
FROM oven/bun:1-slim AS builder
WORKDIR /app
COPY package.json ./
RUN bun install
COPY . .
RUN bun run build

# ── Runtime stage: run the self-contained build output on Bun (lighter + faster than Node). ──
# The BUILD stays on Node above: `mastra build` is a Node bundler/toolchain — there's no runtime
# weight to it, and it's the proven path. Only the *running* service moves to Bun, which is where the
# "lite & lightweight" win is. Verified locally that the bundle boots under Bun (Hono server + pg +
# OpenTelemetry observability + discord.js all load; the server reaches "Mastra API running").
# 1-slim is Debian-based, matching the node:22-slim builder, so the copied node_modules stay ABI-compatible.
FROM oven/bun:1-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
# Bind all interfaces so the container is reachable; Railway injects PORT at runtime
# (the server reads process.env.PORT, default 4111).
ENV MASTRA_HOST=0.0.0.0
COPY --from=builder /app/.mastra/output ./
# Entrypoint starts the server AND self-syncs Inngest on deploy (see entrypoint.sh). Copied from the
# build context (lntera-aiag/), not the builder output.
COPY entrypoint.sh /app/entrypoint.sh
EXPOSE 4111
USER bun
# Pre-fetch the EdgeOne CLI into bun's cache so Studio's first deploy (`bunx edgeone …`) doesn't pay a
# cold npm fetch. Best-effort — the deploy path also falls back to npx/edgeone if this is skipped.
RUN bunx edgeone --version || true
# Run via the entrypoint: `exec bun index.mjs` as PID 1 + a background Inngest auto-sync. (If a future
# build's pnpm-style node_modules layout ever trips Bun, the fallback is to regenerate them here:
# `RUN bun install --production`.)
CMD ["sh", "/app/entrypoint.sh"]
