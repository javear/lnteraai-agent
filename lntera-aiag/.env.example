OPENAI_API_KEY=your-api-key

# BYO LLM providers — per-tenant keys via Portkey Model Catalog (General Agent).
# Supported providers: Groq (gsk_…) and Google Gemini (AIza…). Tenants connect their own key in
# the web app (Integrations → Connect); when both are connected the agent rolls across providers.
# Keys live in Portkey only (never in our DB), so NO per-provider env var is needed here — only the
# two Portkey keys below. Global GROQ_API_KEY is no longer used for production agent calls.
# GROQ_API_KEY=

# Portkey — org-level inference key (all tenant requests route through this gateway)
PORTKEY_API_KEY=
# Portkey Admin API — server-only; provisions per-tenant Groq + Gemini integrations in Model Catalog.
# Use a Service Account with workspace_integrations create/read/update (Workspaces/Configs scopes not required).
PORTKEY_ADMIN_API_KEY=
# Workspace slug or UUID — required for organisation admin keys; omit for workspace-scoped admin keys.
# PORTKEY_WORKSPACE_ID=
# Optional: override Portkey API base URL (default https://api.portkey.ai/v1)
# PORTKEY_BASE_URL=
# Platform-level product embeddings (Portkey gateway -> OpenRouter Qwen3-Embedding). NOT per-tenant.
# Model-catalog form `@<provider-slug>/<model>`; uses the same PORTKEY_API_KEY above (no virtual key).
PORTKEY_EMBEDDING_MODEL=@lntera-open-router/qwen/qwen3-embedding-4b
# Optional: override the MRL output dimension (defaults to 2560 = Qwen3-Embedding-4B native).
# PORTKEY_EMBEDDING_DIMENSIONS=2560
# Optional/deprecated: only if your Portkey route still uses a virtual key.
# PORTKEY_EMBEDDING_VIRTUAL_KEY=
# Public base URL for onboarding links in Discord nudges + the OneSignal push launch URL
# (clicking a push opens <MASTRA_PUBLIC_BASE_URL>/app/). Set to your public/tunnel origin so pushes
# opened on other devices land on the right host. Default http://localhost:4111.
# MASTRA_PUBLIC_BASE_URL=http://localhost:4111
# Optional: separate secret for Groq onboard tokens (defaults to OAUTH_STATE_SECRET)
# GROQ_ONBOARD_SECRET=

# General Agent token efficiency (defaults shown)
# AGENT_LAST_MESSAGES=8
# AGENT_INPUT_TOKEN_LIMIT=7000
# DISCORD_AMBIENT_RECALL_LIMIT=2

# Technical Agent (Studio) — much larger than the chat defaults above: a coding turn carries full
# file contents + verbose npm/build output, not short chat replies (defaults shown)
# TECHNICAL_AGENT_INPUT_TOKEN_LIMIT=32000
# TECHNICAL_AGENT_LAST_MESSAGES=24

# Forge (Studio) git hosting — every tenant project's repo lives under this GitHub organization.
#   GITHUB_TOKEN — a fine-grained PAT with the "Administration: Read and write" repository permission,
#                  repository access set to "All repositories" in the org (a not-yet-created repo can't
#                  be individually selected). A classic PAT with the `repo` scope also works.
#   GITHUB_ORG   — the org login repos are created under, e.g. "your-org".
# Without both set, project init/clone/push/deploy for Forge are unavailable.
GITHUB_TOKEN=
GITHUB_ORG=

# Research reports (web-search / scrape-url tools + generate-research-report) — Parallel.ai API key.
# Without it, web-search/scrape-url no-op with a clear "not configured" message; internal-knowledge-only
# reports still work. Get a key at https://parallel.ai.
# PARALLEL_API_KEY=
# RESEARCH_AGENT_INPUT_TOKEN_LIMIT=32000

# Resend — emails the "report ready" content to the specific user who asked (not the whole tenant).
# Without both set, the report + in-app/push notification still work, just no email is sent.
#   RESEND_API_KEY    — secret key from https://resend.com/api-keys
#   RESEND_FROM_EMAIL — a sender using a domain verified in Resend, e.g. "Lntera <reports@yourdomain.com>"
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# PDF knowledge-document parsing runs in an isolated child process (a bad PDF can otherwise blow well
# past its file size in memory and crash the whole container) — resident-memory ceiling before it gets
# SIGKILLed, in KB (defaults shown).
# PDF_PARSE_MAX_RSS_KB=800000

# Regex guardrails — zero LLM cost (off by default; scans latest user message on input)
# REGEX_FILTER_ENABLED=0
# REGEX_FILTER_INPUT_BLOCK=1
# REGEX_FILTER_INPUT_PII=1
# REGEX_FILTER_OUTPUT_SECRETS=1
# REGEX_FILTER_OUTPUT_PII=1
# REGEX_PII_MASK_MODE=partial
# Mask character for PII/secrets (default · middle dot — avoids Discord * bold/italic). Examples: # x •
# REGEX_PII_MASK_CHAR=·

# Supabase (server-side; bypasses RLS to write to marketplace_connections)
SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred: new-style Secret key starting with `sb_secret_...`
# (Project Settings -> API Keys -> Secret keys). You can rotate these
# independently. Either this OR the legacy service_role JWT below is required.
SUPABASE_SECRET_KEY=
# Legacy fallback. Leave blank if you use SUPABASE_SECRET_KEY above.
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe key for tenant-user auth (Project Settings -> API Keys). Preferred: the
# modern publishable key `sb_publishable_...`; the legacy `anon` JWT still works as a fallback.
# Used by MastraAuthSupabase to validate user tokens and by the /auth page client-side.
# Enable the Google provider in the Supabase dashboard and add
# <MASTRA_PUBLIC_BASE_URL>/auth to the Auth redirect URLs.
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for SUPABASE_PUBLISHABLE_KEY. Leave blank if you set the publishable key.
SUPABASE_ANON_KEY=

# Postgres connection for Mastra agent memory (threads + chat history) — required.
# Tables auto-created under the `mastra` schema in Supabase Postgres.
# Use the Supabase SESSION POOLER (port 5432) or a DIRECT connection with sslmode=require.
# Do NOT use the transaction pooler (port 6543) — it breaks node-postgres prepared statements.
# Supabase dashboard -> Project Settings -> Database -> Connection string (Session pooler).
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Connection pool size. Kept at 8 to stay under the session pooler's default 15-client cap.
# Raise it for a direct connection (higher ceiling) or a larger configured pooler size.
# DATABASE_POOL_MAX=8

# OneSignal push notifications (optional). When unset, push silently no-ops; in-app realtime
# notifications still work. Register the OneSignal app, then set:
#   ONESIGNAL_APP_ID — browser-safe app id (returned by /svc/v1/public-config to the client).
#   ONESIGNAL_SAFARI_WEB_ID — browser-safe Safari web id (web.onesignal.auto....), for Safari push.
#   ONESIGNAL_REST_API_KEY — SERVER ONLY; used to trigger pushes targeting the `tenant_id` tag. Never expose.
# Clients register external_id = user uuid + tag tenant_id = tenant uuid, so we store no player ids.
# Web Push also needs web/public/onesignal/OneSignalSDKWorker.js (committed) served at /app/onesignal/.
# ONESIGNAL_APP_ID=
# ONESIGNAL_SAFARI_WEB_ID=
# ONESIGNAL_REST_API_KEY=

# ngrok tunnel (dev only) — `npm run tunnel` exposes the local server over HTTPS so the native
# (Capacitor/Electron) app can reach your machine. Free token: https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=
# Optional: a reserved/static domain for a STABLE url (one free per account) so you don't rebuild native each run.
# NGROK_DOMAIN=your-subdomain.ngrok-free.app

# Shopee Open Platform
# Register an app at https://open.shopee.com/ and obtain partner credentials.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Must exactly match the URL whitelisted in your Shopee app settings.
# If using Supabase HTTPS bridge, whitelist:
# https://<project-ref>.functions.supabase.co/oauth-bridge/shopee/callback
# and keep SHOPEE_REDIRECT_URL below as local callback target.
SHOPEE_REDIRECT_URL=http://localhost:4111/oauth/shopee/callback
# Region picks the default base URL when SHOPEE_BASE_URL is not set:
#   live -> https://partner.shopeemobile.com (SG)
#   test -> https://openplatform.sandbox.test-stable.shopee.sg
# Other live regions you may need (set via SHOPEE_BASE_URL below):
#   https://openplatform.shopee.cn       (Chinese Mainland deployments)
#   https://openplatform.shopee.com.br   (US deployments)
#   https://openplatform.sandbox.test-stable.shopee.cn (CN sandbox)
SHOPEE_REGION=test
# Optional: explicit base URL override. Takes precedence over SHOPEE_REGION.
SHOPEE_BASE_URL=

# Shopee Push (inbound webhook) — configure in Shopee Open Platform → Push Configuration.
# Set the Push URL there to your public `/webhooks/shopee` endpoint (HTTPS required for live).
#   live:  https://<your-public-host>/webhooks/shopee
#   dev:   use a tunnel (ngrok / Cloudflare Tunnel) → https://<tunnel>/webhooks/shopee
# Then copy the "Push Partner Key" from the same screen into SHOPEE_PUSH_PARTNER_KEY.
# Without this key, /webhooks/shopee returns 503.
SHOPEE_PUSH_PARTNER_KEY=
# Optional: explicit base URL Mastra should use when reconstructing the URL Shopee saw
# (used to verify the HMAC signature). Set when running behind a proxy whose forwarded
# headers (x-forwarded-proto / x-forwarded-host) are stripped or differ from the
# registered Push URL. Example: SHOPEE_PUSH_BASE_URL=https://api.example.com
SHOPEE_PUSH_BASE_URL=

# TikTok Shop Partner
# Register an app at https://partner.tiktokshop.com/ and obtain app credentials.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Must exactly match the URL whitelisted in your TikTok app settings.
# If using Supabase HTTPS bridge, whitelist:
# https://<project-ref>.functions.supabase.co/oauth-bridge/tiktok/callback
# and keep TIKTOK_REDIRECT_URL below as local callback target.
TIKTOK_REDIRECT_URL=http://localhost:4111/oauth/tiktok/callback
# Optional base URL overrides for TikTok Shop. Defaults shown.
# Auth endpoints (oauth/authorize, token/get, token/refresh):
#   default https://auth.tiktok-shops.com
TIKTOK_AUTH_BASE_URL=
# API endpoints (product, order, etc.):
#   default https://open-api.tiktokglobalshop.com
# US sellers: https://open-api.tiktokshop.us
TIKTOK_API_BASE_URL=

# TikTok Shop webhooks (inbound) — configure in Partner Center → App → Webhooks.
# Set the Notification URL there to your public `/webhooks/tiktok` endpoint (HTTPS required).
#   live:  https://<your-public-host>/webhooks/tiktok
#   dev:   use a tunnel (ngrok / Cloudflare Tunnel) → https://<tunnel>/webhooks/tiktok
# Signatures are verified with TIKTOK_APP_SECRET (already set above) using X-TTS-Signature
# header. No extra env var is required; just whitelist the URL in Partner Center.
# Optional override of the public base URL when displaying/printing webhook registration URLs.
TIKTOK_WEBHOOK_PUBLIC_BASE_URL=

# Verbose TikTok order detail/search traces on stderr (get-order-details, TikTok APIs).
# MASTRA_DEBUG_TIKTOK_ORDERS=1

# Random secret used to sign the OAuth `state` parameter (CSRF protection).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=

# Open API (`/svc/v1/*`) — JWT for tenant-scoped integration management
# Used by POST /svc/v1/auth/token (mint) and Bearer auth on integration routes.
#
# The Mastra Node process does not load this file automatically: set variables in your
# shell, platform (Docker/K8s/CI), or IDE run configuration.
# For local work, `npm run dev` / `npm run start` run `scripts/run-mastra-with-local-env.mjs`,
# which merges `.env` into env for keys that are missing or whitespace-only (non-empty shell exports still win).
#
# Optional base URL for scripts/clients (default http://localhost:4111).
# OPENAPI_BASE_URL=http://localhost:4111
OPENAPI_JWT_SECRET=
# Must be the literal name above; min 16 characters (64-char hex from randomBytes(32) is ideal).
# If you still see "missing or empty", check: (1) no typo in the name, (2) not overridden by an empty shell export,
# (3) restart `npm run dev` after editing `.env`.
OPENAPI_SERVICE_API_KEY=
# Strong random string for X-Service-Api-Key on POST /svc/v1/auth/token (bootstrap; replace with IdP later).
# Optional access token default and maximum lifetime in seconds (default 900).
# Clients may POST a shorter ttl_seconds on /svc/v1/auth/token; it is clamped to this max.
# OPENAPI_JWT_TTL_SECONDS=900

# Mastra native API auth — the SAME OPENAPI_JWT_SECRET above also guards Mastra's native
# /api/* routes (agents, tools, workflows) in PRODUCTION, via MastraJwtAuth. Mint a token at
# POST /svc/v1/auth/token and send it as `Authorization: Bearer <token>` (e.g. from
# @mastra/client-js or your backend).
#
# In local dev (`mastra dev` sets MASTRA_DEV=true) auth is DISABLED so the Studio playground
# loads — Studio relies on the framework's dev bypass, which any auth provider disables, and
# MastraJwtAuth has no interactive login UI. Production (`mastra start`) always enforces auth.
# Guard: set NODE_ENV=production in deployed environments so auth stays ON even if MASTRA_DEV
# ever leaks in.
#
# Local playground only: tenant UUID the playground's /api/* calls act as (no effect in
# production, where the tenant comes from the JWT). Leave unset in deployed environments.
# MASTRA_DEV_TENANT_ID=
#
# CORS allowlist for browser / @mastra/client-js callers of /api/* (comma-separated origins).
# Empty = block all cross-origin browser requests. Use `*` to allow any origin
# (credentials are auto-disabled in wildcard mode; safe because auth is a Bearer token,
# not cookies). Prefer an explicit allowlist in production.
# When the SPA is hosted standalone on Vercel, include its origin here.
# MASTRA_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:4173
#
# Where the web SPA is hosted, so server-side redirects (OAuth callbacks, /auth) and push deep-links
# target the right app. Set to your Vercel origin when the SPA is hosted standalone. Leave UNSET to
# keep the legacy monolith behavior (SPA served by this server under /app). See web/VERCEL.md.
# WEB_APP_ORIGIN=https://your-app.vercel.app
#
# Web app (Vite+React SPA served at /app by this server — the monolith target). Build with
# `npm run build` in web/ (outputs to src/mastra/public/app). The server serves it from WEB_DIST_DIR
# (relative to cwd; default src/mastra/public/app). Override only for deploys that ship a different
# layout (e.g. .mastra/output/public/app). The SPA reads Supabase config from /svc/v1/public-config.
# NOTE: not needed when the frontend is deployed standalone on Vercel (`npm run build:vercel`).
# WEB_DIST_DIR=src/mastra/public/app

# Discord — optional same process as Mastra
# `npm run dev` sets DISCORD_EMBEDDED=1 so Discord starts with Studio (one terminal).
# For production Mastra only, omit DISCORD_EMBEDDED or set DISCORD_EMBEDDED=0; use `npm run discord` for a dedicated bot process.
DISCORD_EMBEDDED=
#
# Recommended (single Discord application for all tenants):
# Set the platform bot token here. Per-tenant linkage (guildId, channelId) and consent live in
# `tenant_integrations` (integration_code = discord) via Open API, OAuth install, or Supabase — not per-tenant bot tokens.
DISCORD_BOT_TOKEN=
# Groq model for the Discord reply formatter (second pass; no tools). Default: groq/llama-3.1-8b-instant
# DISCORD_FORMAT_MODEL=groq/llama-3.1-8b-instant
#
# Discord OAuth2 bot install (`GET /oauth/discord/start` → Discord → `/oauth/discord/callback`).
# Developer Portal: Application → OAuth2 → Redirects → add this URL EXACTLY (same as DISCORD_REDIRECT_URI):
#   http://localhost:4111/oauth/discord/callback
# If Discord shows "Invalid OAuth2 redirect_uri", the allowlist does not match (typo, http vs https,
# localhost vs 127.0.0.1, port, or trailing slash). Save changes in the portal after adding.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4111/oauth/discord/callback
# Permission bitfield for the bot when invited (default 68608 = View Channel + Send Messages + Read Message History).
# DISCORD_BOT_PERMISSIONS=68608
# Optional string stored on successful install as config.termsAcknowledgedVersion (e.g. policy version).
# DISCORD_TERMS_VERSION=
#
# Legacy only — omit DISCORD_BOT_TOKEN to use this mode:
# One Gateway client per tenant; each row references Vault JSON {"token":"..."} via config.vaultSecretRef.
# Enable Message Content Intent + Privileged intents in the Discord Developer Portal if you handle messages.

# ── Inngest (scheduled business insights) ─────────────────────────────────────
# Inngest drives the per-tenant scheduled analysis. It invokes our serve endpoint at
# `${MASTRA_PUBLIC_BASE_URL}/inngest` (NOT /api/inngest — Mastra reserves /api). Register that URL in
# Inngest Cloud; keys come from the Inngest app (Cloud → your app → Keys).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Local testing with the inngest-cli dev server: set INNGEST_DEV=1 (SDK trusts the local dev server
# instead of Cloud) and run `npx inngest-cli dev -u http://localhost:4111/inngest`.
# INNGEST_DEV=
#
# Re-arm on edit (default off): when a tenant changes their schedule's TIME or DAYS, clear today's
# "already ran" mark so a NEW future time today fires TODAY instead of the next selected day. Off
# preserves the free-tier one-run-per-day guarantee. Either way the UI/agent tells the user when the
# next analysis lands. Accepts 1/true/yes/on.
# INSIGHTS_REARM_ON_EDIT=
#
# Insight narration retries (default 3, range 1–6): when narrating the analysis, the LLM call already
# rolls across every connected model/provider; on a TRANSIENT spike (Gemini "high demand", 429/5xx,
# timeout) we wait (2s/6s/12s backoff) and retry up to this many times before delivering the plain
# deterministic fallback. Set to 1 to disable waiting (fall back immediately).
# INSIGHT_NARRATE_MAX_ATTEMPTS=
