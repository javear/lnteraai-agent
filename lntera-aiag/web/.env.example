# Frontend build-time env (Vite). Baked into the bundle at build time and prefixed onto every
# backend call via apiUrl() (src/lib/runtime.ts).
#
# Leave EMPTY for the Mastra monolith (`npm run build`/`npm run dev`) — the SPA is same-origin at /app.
# Set to the backend origin for the standalone Vercel build (`npm run build:vercel`). See VERCEL.md.
# VITE_API_BASE_URL=https://your-backend.example.com

# NATIVE builds only (`build:native`, in web/.env.native — gitignored). Baking the PUBLIC Supabase
# config makes the app boot instantly instead of blocking the splash on a /public-config round-trip.
# (Push + Google One Tap ids are still refreshed from the backend in the background.) Web omits these.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<public anon key>
# Optional (else pulled from the backend after boot):
# VITE_ONESIGNAL_APP_ID=
# VITE_GOOGLE_CLIENT_ID=
